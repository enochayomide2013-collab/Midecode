rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Phase 3: Global Primitives & Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedCommunityActor() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.phone_number != null
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (
          request.auth.token.email == 'enochayomide2013@gmail.com' &&
          request.auth.token.email_verified == true
        ) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidStringArray(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || arr[0] is string);
    }

    function hasAuthEmail() {
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email is string && request.auth.token.email.size() >= 3;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function authEmailSlug() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }

    function isProjectMember(projData) {
      return isSignedIn() && (
        projData.ownerId == request.auth.uid ||
        ('collaboratorIds' in projData && projData.collaboratorIds is list && request.auth.uid in projData.collaboratorIds)
      );
    }

    function isProjectEditor(projData) {
      return isSignedIn() && (
        projData.ownerId == request.auth.uid ||
        (
          'collaboratorIds' in projData &&
          projData.collaboratorIds is list &&
          request.auth.uid in projData.collaboratorIds &&
          'collaboratorRoles' in projData &&
          projData.collaboratorRoles is map &&
          request.auth.uid in projData.collaboratorRoles &&
          projData.collaboratorRoles[request.auth.uid] in ['owner', 'editor']
        )
      );
    }

    // -------------------------------------------------------------------------
    // Phase 2: Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid', 'displayName', 'experienceLevel', 'preferredLanguages',
        'learningGoals', 'interests', 'onboardingComplete', 'xp', 'level',
        'streak', 'role', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'photoURL', 'email', 'phoneNumber', 'country',
        'experienceLevel', 'preferredLanguages', 'learningGoals', 'interests',
        'onboardingComplete', 'activeCareerPathId', 'xp', 'level', 'streak',
        'lastActivityDate', 'role', 'createdAt', 'updatedAt'
      ]) &&
      data.uid == userId &&
      isValidId(data.uid) &&
      isValidString(data.displayName, 1, 80) &&
      isValidOptionalString(data, 'photoURL', 500) &&
      isValidOptionalString(data, 'email', 254) &&
      isValidOptionalString(data, 'phoneNumber', 32) &&
      isValidOptionalString(data, 'country', 80) &&
      isValidOptionalString(data, 'activeCareerPathId', 64) &&
      isValidOptionalString(data, 'lastActivityDate', 32) &&
      data.experienceLevel in ['beginner', 'intermediate', 'advanced'] &&
      isValidStringArray(data.preferredLanguages, 12) &&
      isValidStringArray(data.learningGoals, 12) &&
      isValidStringArray(data.interests, 16) &&
      data.onboardingComplete is bool &&
      data.xp is number && data.xp >= 0 && data.xp <= 10000000 &&
      data.level is number && data.level >= 1 && data.level <= 500 &&
      data.streak is number && data.streak >= 0 && data.streak <= 10000 &&
      data.role in ['member', 'moderator', 'admin'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'level', 'xp', 'streak', 'badgesCount', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'level', 'xp', 'streak', 'badgesCount', 'updatedAt']) &&
        data.uid == userId &&
        isValidId(data.uid) &&
        isValidString(data.displayName, 1, 80) &&
        isValidOptionalString(data, 'photoURL', 500) &&
        data.level is number && data.level >= 1 && data.level <= 500 &&
        data.xp is number && data.xp >= 0 && data.xp <= 10000000 &&
        data.streak is number && data.streak >= 0 && data.streak <= 10000 &&
        data.badgesCount is number && data.badgesCount >= 0 && data.badgesCount <= 500 &&
        data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll(['userId', 'theme', 'editorTheme', 'editorFontSize', 'tabSize', 'autosave', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'theme', 'editorTheme', 'editorFontSize', 'tabSize', 'autosave', 'updatedAt']) &&
        data.userId == userId &&
        data.theme in ['dark', 'light'] &&
        data.editorTheme in ['oneDark', 'githubLight'] &&
        data.editorFontSize is number && data.editorFontSize >= 11 && data.editorFontSize <= 24 &&
        data.tabSize is number && (data.tabSize == 2 || data.tabSize == 4) &&
        data.autosave is bool &&
        data.updatedAt is timestamp;
    }

    function isValidCourseProgress(data, userId, courseId) {
      return data.keys().hasAll(['userId', 'courseId', 'completedLessonIds', 'completedExerciseIds', 'quizScores', 'progressPercent', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'courseId', 'completedLessonIds', 'completedExerciseIds', 'quizScores', 'lastLessonId', 'progressPercent', 'updatedAt']) &&
        data.userId == userId &&
        data.courseId == courseId &&
        isValidId(data.courseId) &&
        isValidStringArray(data.completedLessonIds, 200) &&
        isValidStringArray(data.completedExerciseIds, 200) &&
        data.quizScores is map && data.quizScores.size() <= 50 &&
        isValidOptionalString(data, 'lastLessonId', 80) &&
        data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100 &&
        data.updatedAt is timestamp;
    }

    function isValidBookmark(data, bookmarkId) {
      return data.keys().hasAll(['id', 'userId', 'targetType', 'targetId', 'title', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'targetType', 'targetId', 'title', 'createdAt']) &&
        data.id == bookmarkId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.targetType in ['lesson', 'doc', 'post', 'project', 'mission'] &&
        isValidString(data.targetId, 1, 128) &&
        isValidString(data.title, 1, 160) &&
        data.createdAt is timestamp;
    }

    function isValidNote(data, noteId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'courseId', 'lessonId', 'title', 'content', 'createdAt', 'updatedAt']) &&
        data.id == noteId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidOptionalString(data, 'courseId', 80) &&
        isValidOptionalString(data, 'lessonId', 80) &&
        isValidString(data.title, 1, 160) &&
        isValidString(data.content, 0, 10000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProject(data, projectId) {
      return data.keys().hasAll(['id', 'ownerId', 'ownerName', 'title', 'description', 'language', 'visibility', 'isPortfolio', 'milestonesCompleted', 'status', 'version', 'storageBytes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'ownerId', 'ownerName', 'title', 'description', 'language', 'guidedProjectId', 'architectureId',
          'visibility', 'isPortfolio', 'milestonesCompleted', 'status', 'version', 'storageBytes',
          'collaboratorIds', 'collaboratorRoles', 'collaboratorNames', 'lastEditedByUid', 'lastEditedByName',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == projectId &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidString(data.ownerName, 1, 80) &&
        isValidString(data.title, 1, 120) &&
        isValidString(data.description, 0, 1000) &&
        data.language in ['web', 'javascript', 'typescript', 'python', 'sql', 'html', 'css'] &&
        isValidOptionalString(data, 'guidedProjectId', 80) &&
        isValidOptionalString(data, 'architectureId', 128) &&
        data.visibility in ['private', 'public'] &&
        data.isPortfolio is bool &&
        isValidStringArray(data.milestonesCompleted, 30) &&
        data.status in ['active', 'submitted', 'completed'] &&
        data.version is number && data.version >= 1 && data.version <= 10000 &&
        data.storageBytes is number && data.storageBytes >= 0 && data.storageBytes <= 5000000 &&
        (!('collaboratorIds' in data) || isValidStringArray(data.collaboratorIds, 20)) &&
        (!('collaboratorRoles' in data) || (data.collaboratorRoles is map && data.collaboratorRoles.size() <= 20)) &&
        (!('collaboratorNames' in data) || (data.collaboratorNames is map && data.collaboratorNames.size() <= 20)) &&
        isValidOptionalString(data, 'lastEditedByUid', 128) &&
        isValidOptionalString(data, 'lastEditedByName', 80) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProjectFile(data, projectId, fileId) {
      return data.keys().hasAll(['id', 'projectId', 'ownerId', 'name', 'folder', 'language', 'visibility', 'content', 'updatedAt']) &&
        data.keys().hasOnly([
          'id', 'projectId', 'ownerId', 'name', 'folder', 'language', 'visibility', 'content',
          'collaboratorIds', 'lastEditedByUid', 'lastEditedByName', 'updatedAt'
        ]) &&
        data.id == fileId &&
        data.projectId == projectId &&
        isValidId(data.id) &&
        isValidId(data.projectId) &&
        isValidId(data.ownerId) &&
        isValidString(data.name, 1, 120) &&
        isValidString(data.folder, 0, 120) &&
        isValidString(data.language, 1, 32) &&
        data.visibility in ['private', 'public'] &&
        isValidString(data.content, 0, 150000) &&
        (!('collaboratorIds' in data) || isValidStringArray(data.collaboratorIds, 20)) &&
        isValidOptionalString(data, 'lastEditedByUid', 128) &&
        isValidOptionalString(data, 'lastEditedByName', 80) &&
        data.updatedAt is timestamp;
    }

    function isValidProjectVersion(data, projectId, versionId) {
      return data.keys().hasAll(['id', 'projectId', 'ownerId', 'versionNumber', 'label', 'filesCount', 'snapshot', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'projectId', 'ownerId', 'versionNumber', 'label', 'description',
          'authorId', 'authorName', 'changeType', 'aiOperation', 'changedFiles',
          'parentVersionId', 'collaboratorIds', 'filesCount', 'snapshot', 'createdAt'
        ]) &&
        data.id == versionId &&
        data.projectId == projectId &&
        isValidId(data.id) &&
        isValidId(data.projectId) &&
        isValidId(data.ownerId) &&
        data.versionNumber is number && data.versionNumber >= 1 && data.versionNumber <= 10000 &&
        isValidString(data.label, 1, 120) &&
        isValidOptionalString(data, 'description', 500) &&
        isValidOptionalString(data, 'authorId', 128) &&
        isValidOptionalString(data, 'authorName', 80) &&
        (!('changeType' in data) || data.changeType in ['manual', 'autosave', 'ai_build', 'ai_fix', 'restore', 'collab']) &&
        isValidOptionalString(data, 'aiOperation', 240) &&
        (!('changedFiles' in data) || isValidStringArray(data.changedFiles, 50)) &&
        isValidOptionalString(data, 'parentVersionId', 128) &&
        (!('collaboratorIds' in data) || isValidStringArray(data.collaboratorIds, 20)) &&
        data.filesCount is number && data.filesCount >= 0 && data.filesCount <= 100 &&
        data.snapshot is list && data.snapshot.size() <= 50 &&
        data.createdAt is timestamp;
    }

    function isValidPlayground(data, playgroundId) {
      return data.keys().hasAll(['id', 'ownerId', 'ownerName', 'title', 'templateId', 'html', 'css', 'js', 'visibility', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'ownerName', 'title', 'templateId', 'html', 'css', 'js', 'visibility', 'forkedFrom', 'createdAt', 'updatedAt']) &&
        data.id == playgroundId &&
        isValidId(data.id) &&
        isValidId(data.ownerId) &&
        isValidString(data.ownerName, 1, 80) &&
        isValidString(data.title, 1, 120) &&
        isValidString(data.templateId, 1, 64) &&
        isValidString(data.html, 0, 100000) &&
        isValidString(data.css, 0, 100000) &&
        isValidString(data.js, 0, 100000) &&
        data.visibility in ['private', 'public'] &&
        isValidOptionalString(data, 'forkedFrom', 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidChallengeAttempt(data, attemptId) {
      return data.keys().hasAll(['id', 'userId', 'challengeId', 'language', 'code', 'passed', 'passedCount', 'totalCount', 'executionMs', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'challengeId', 'language', 'code', 'passed', 'passedCount', 'totalCount', 'executionMs', 'createdAt']) &&
        data.id == attemptId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.challengeId, 1, 80) &&
        data.language in ['javascript', 'typescript', 'python'] &&
        isValidString(data.code, 1, 50000) &&
        data.passed is bool &&
        data.passedCount is number && data.passedCount >= 0 && data.passedCount <= 100 &&
        data.totalCount is number && data.totalCount >= 1 && data.totalCount <= 100 &&
        data.executionMs is number && data.executionMs >= 0 && data.executionMs <= 30000 &&
        data.createdAt is timestamp;
    }

    function isValidXpTransaction(data, txId) {
      return data.keys().hasAll(['id', 'userId', 'sourceType', 'sourceId', 'amount', 'reason', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'sourceType', 'sourceId', 'amount', 'reason', 'createdAt']) &&
        data.id == txId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.sourceType in ['lesson', 'quiz', 'challenge', 'project', 'mission'] &&
        isValidString(data.sourceId, 1, 100) &&
        !(data.sourceType == 'mission' && data.sourceId.matches('^(custom_|mission-custom).*')) &&
        data.amount is number && data.amount >= 5 && data.amount <= 250 &&
        isValidString(data.reason, 1, 160) &&
        data.createdAt is timestamp;
    }

    function isValidAchievement(data, achievementId) {
      return data.keys().hasAll(['id', 'userId', 'badgeId', 'title', 'unlockedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'badgeId', 'title', 'unlockedAt']) &&
        data.id == achievementId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.badgeId, 1, 64) &&
        isValidString(data.title, 1, 120) &&
        data.unlockedAt is timestamp;
    }

    function isValidCommunityPost(data, postId) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'title', 'body', 'category', 'tags', 'visibility', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'authorId', 'authorName', 'authorRole', 'title', 'body', 'category', 'tags', 'codeSnippet', 'visibility', 'likesCount', 'commentsCount', 'createdAt', 'updatedAt']) &&
        data.id == postId &&
        isValidId(data.id) &&
        isValidId(data.authorId) &&
        isValidString(data.authorName, 1, 80) &&
        (!('authorRole' in data) || data.authorRole in ['member', 'moderator', 'admin']) &&
        isValidString(data.title, 3, 180) &&
        isValidString(data.body, 5, 12000) &&
        data.category in ['question', 'showcase', 'discussion', 'tip', 'announcement'] &&
        isValidStringArray(data.tags, 8) &&
        isValidOptionalString(data, 'codeSnippet', 8000) &&
        data.visibility in ['public', 'hidden'] &&
        data.likesCount is number && data.likesCount >= 0 && data.likesCount <= 1000000 &&
        data.commentsCount is number && data.commentsCount >= 0 && data.commentsCount <= 1000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidComment(data, postId, commentId) {
      return data.keys().hasAll(['id', 'postId', 'authorId', 'authorName', 'body', 'createdAt']) &&
        data.keys().hasOnly(['id', 'postId', 'authorId', 'authorName', 'authorRole', 'body', 'createdAt']) &&
        data.id == commentId &&
        data.postId == postId &&
        isValidId(data.id) &&
        isValidId(data.postId) &&
        isValidId(data.authorId) &&
        isValidString(data.authorName, 1, 80) &&
        (!('authorRole' in data) || data.authorRole in ['member', 'moderator', 'admin']) &&
        isValidString(data.body, 1, 4000) &&
        data.createdAt is timestamp;
    }

    function isValidReport(data, reportId) {
      return data.keys().hasAll(['id', 'reporterId', 'targetType', 'targetId', 'reason', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'reporterId', 'targetType', 'targetId', 'reason', 'details', 'status', 'createdAt', 'updatedAt']) &&
        data.id == reportId &&
        isValidId(data.id) &&
        isValidId(data.reporterId) &&
        data.targetType in ['post', 'comment', 'user'] &&
        isValidString(data.targetId, 1, 128) &&
        data.reason in ['spam', 'harassment', 'misinformation', 'unsafe_code', 'other'] &&
        isValidOptionalString(data, 'details', 1000) &&
        data.status in ['open', 'reviewed', 'resolved', 'dismissed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'body', 'read', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'body', 'linkView', 'read', 'createdAt']) &&
        data.id == notificationId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.title, 1, 140) &&
        isValidString(data.body, 1, 500) &&
        isValidOptionalString(data, 'linkView', 64) &&
        data.read is bool &&
        data.createdAt is timestamp;
    }

    function isValidCareerProgress(data, userId) {
      return data.keys().hasAll(['userId', 'selectedPathId', 'completedSkillIds', 'completedProjectIds', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'selectedPathId', 'completedSkillIds', 'completedProjectIds', 'updatedAt']) &&
        data.userId == userId &&
        isValidString(data.selectedPathId, 1, 64) &&
        isValidStringArray(data.completedSkillIds, 100) &&
        isValidStringArray(data.completedProjectIds, 100) &&
        data.updatedAt is timestamp;
    }

    function isValidAiConversation(data, conversationId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'mode', 'messages', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'mode', 'messages', 'createdAt', 'updatedAt']) &&
        data.id == conversationId &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.title, 1, 140) &&
        data.mode in ['learn', 'debug', 'explain', 'practice', 'build', 'review'] &&
        data.messages is list && data.messages.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminAuditLog(data, logId) {
      return data.keys().hasAll(['id', 'adminId', 'action', 'targetPath', 'createdAt']) &&
        data.keys().hasOnly(['id', 'adminId', 'action', 'targetPath', 'createdAt']) &&
        data.id == logId &&
        isValidId(data.id) &&
        isValidId(data.adminId) &&
        isValidString(data.action, 1, 120) &&
        isValidString(data.targetPath, 1, 200) &&
        data.createdAt is timestamp;
    }

    function isValidMissionLeaderboardEntry(data, entryId) {
      return data.keys().hasAll(['id', 'missionId', 'userId', 'displayName', 'xpAwarded', 'durationSeconds', 'version', 'efficiencyScore', 'completedAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'missionId', 'userId', 'displayName', 'photoURL', 'xpAwarded', 'durationSeconds', 'version', 'efficiencyScore', 'completedAt', 'updatedAt']) &&
        data.id == entryId &&
        isValidId(data.id) &&
        isValidId(data.missionId) &&
        isValidId(data.userId) &&
        isValidString(data.displayName, 1, 80) &&
        isValidOptionalString(data, 'photoURL', 500) &&
        data.xpAwarded is number && data.xpAwarded >= 0 && data.xpAwarded <= 250 &&
        data.durationSeconds is number && data.durationSeconds >= 1 && data.durationSeconds <= 864000 &&
        data.version is number && data.version >= 1 && data.version <= 10000 &&
        data.efficiencyScore is number && data.efficiencyScore >= 0 && data.efficiencyScore <= 10000 &&
        data.completedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Mission Mode Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidMission(data, missionId) {
      return data.keys().hasAll([
        'id', 'title', 'description', 'category', 'difficulty', 'language',
        'supportedLanguages', 'requiredSkills', 'prerequisiteMissionIds',
        'prerequisitesOptional', 'relatedLessonIds', 'learningObjectives',
        'estimatedMinutes', 'scenario', 'requirements', 'instructions', 'hints',
        'completionCriteria', 'xpReward', 'badgeId', 'badgeTitle', 'isFeatured',
        'status', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'title', 'description', 'category', 'difficulty', 'language',
        'supportedLanguages', 'requiredSkills', 'prerequisiteMissionIds',
        'prerequisiteSummary', 'prerequisitesOptional', 'relatedLessonIds',
        'learningObjectives', 'estimatedMinutes', 'scenario', 'clientName',
        'userRole', 'projectObjective', 'constraints', 'requirements',
        'instructions', 'hints', 'completionCriteria', 'xpReward', 'badgeId',
        'badgeTitle', 'isFeatured', 'status', 'qualityStatus', 'qualityReport',
        'readinessQuestions', 'authorId', 'createdAt', 'updatedAt'
      ]) &&
      data.id == missionId &&
      isValidId(data.id) &&
      isValidId(data.authorId) &&
      isValidString(data.title, 3, 140) &&
      isValidString(data.description, 10, 800) &&
      data.category in [
        'HTML and CSS', 'JavaScript', 'Python', 'Frontend Development',
        'Backend Development', 'Full-Stack Development', 'Database Development',
        'Algorithms and Data Structures', 'API Development', 'Software Engineering'
      ] &&
      data.difficulty in ['Beginner', 'Intermediate', 'Advanced', 'Expert'] &&
      data.language in ['web', 'javascript', 'python', 'sql'] &&
      isValidStringArray(data.supportedLanguages, 6) &&
      isValidStringArray(data.requiredSkills, 12) &&
      isValidStringArray(data.prerequisiteMissionIds, 10) &&
      isValidOptionalString(data, 'prerequisiteSummary', 300) &&
      data.prerequisitesOptional is bool &&
      isValidStringArray(data.relatedLessonIds, 12) &&
      isValidStringArray(data.learningObjectives, 10) &&
      data.estimatedMinutes is number && data.estimatedMinutes >= 5 && data.estimatedMinutes <= 600 &&
      isValidString(data.scenario, 10, 3000) &&
      isValidOptionalString(data, 'clientName', 140) &&
      isValidOptionalString(data, 'userRole', 140) &&
      isValidOptionalString(data, 'projectObjective', 1000) &&
      (!('constraints' in data) || isValidStringArray(data.constraints, 15)) &&
      isValidStringArray(data.requirements, 20) &&
      isValidStringArray(data.instructions, 25) &&
      data.hints is list && data.hints.size() <= 10 &&
      isValidString(data.completionCriteria, 5, 1000) &&
      data.xpReward is number && data.xpReward >= 25 && data.xpReward <= 250 &&
      isValidString(data.badgeId, 1, 64) &&
      isValidString(data.badgeTitle, 1, 120) &&
      data.isFeatured is bool &&
      data.status in ['draft', 'published', 'archived'] &&
      (!('qualityStatus' in data) || data.qualityStatus in ['draft', 'testing', 'approved']) &&
      (!('qualityReport' in data) || data.qualityReport is map) &&
      (!('readinessQuestions' in data) || (data.readinessQuestions is list && data.readinessQuestions.size() <= 10)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidMissionCheckpoint(data, checkpointId) {
      return data.keys().hasAll([
        'id', 'missionId', 'order', 'title', 'instructions', 'requirements',
        'completionCriteria', 'validationMethod', 'dependsOn', 'isAssessed',
        'status', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
