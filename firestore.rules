    function isValidArchitectureVersion(data, archId, versionId) {
      return data.keys().hasAll([
        'id', 'architectureId', 'userId', 'versionNumber', 'label',
        'changeSummary', 'snapshot', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'architectureId', 'userId', 'versionNumber', 'label',
        'changeSummary', 'snapshot', 'createdAt'
      ]) &&
      data.id == versionId &&
      data.architectureId == archId &&
      isValidId(data.id) &&
      isValidId(data.architectureId) &&
      isValidId(data.userId) &&
      data.versionNumber is number && data.versionNumber >= 1 && data.versionNumber <= 1000 &&
      isValidString(data.label, 1, 140) &&
      isValidString(data.changeSummary, 0, 500) &&
      data.snapshot is map &&
      data.createdAt is timestamp;
    }

    function isValidActivityEvent(data, eventId) {
      return data.keys().hasAll([
        'id', 'userId', 'category', 'action', 'aiAssisted', 'dayKey', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'userId', 'category', 'action', 'language', 'technology',
        'aiAssisted', 'durationSeconds', 'scorePct', 'projectId', 'dayKey', 'createdAt'
      ]) &&
      data.id == eventId &&
      isValidId(data.id) &&
      isValidId(data.userId) &&
      data.category in ['lesson', 'exercise', 'challenge', 'project', 'ide', 'version', 'testlab', 'architect', 'ai'] &&
      isValidString(data.action, 1, 140) &&
      isValidOptionalString(data, 'language', 32) &&
      isValidOptionalString(data, 'technology', 64) &&
      data.aiAssisted is bool &&
      (!('durationSeconds' in data) || (data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 86400)) &&
      (!('scorePct' in data) || (data.scorePct is number && data.scorePct >= 0 && data.scorePct <= 100)) &&
      isValidOptionalString(data, 'projectId', 128) &&
      isValidString(data.dayKey, 10, 10) &&
      data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Rules
    // -------------------------------------------------------------------------

    // Connection check document (read-only)
    match /test/connection {
      allow get: if true;
    }

    // Admins registry
    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // Private user profiles (PII protected)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().role == 'member' &&
        incoming().xp == 0 &&
        incoming().level == 1 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidUserProfile(incoming(), userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().xp >= existing().xp &&
          incoming().xp <= existing().xp + 250 &&
          incoming().level >= existing().level &&
          incoming().level <= existing().level + 2 &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'email', 'phoneNumber', 'country',
            'experienceLevel', 'preferredLanguages', 'learningGoals', 'interests',
            'onboardingComplete', 'activeCareerPathId', 'xp', 'level', 'streak',
            'lastActivityDate', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // Non-PII public profiles
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidPublicProfile(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidPublicProfile(incoming(), userId) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().xp >= existing().xp &&
          incoming().xp <= existing().xp + 250 &&
          incoming().level >= existing().level &&
          incoming().level <= existing().level + 2 &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'level', 'xp', 'streak', 'badgesCount', 'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin();
    }

    // User settings
    match /userSettings/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserSettings(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidUserSettings(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'theme', 'editorTheme', 'editorFontSize', 'tabSize', 'autosave', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // User course progress
    match /userProgress/{userId}/courses/{courseId} {
      allow get: if isValidId(userId) && isValidId(courseId) && (isOwner(userId) || isAdmin());
      allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isValidId(courseId) && isOwner(userId) &&
        isValidCourseProgress(incoming(), userId, courseId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidId(courseId) && isOwner(userId) &&
        isValidCourseProgress(incoming(), userId, courseId) &&
        incoming().userId == existing().userId &&
        incoming().courseId == existing().courseId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'completedLessonIds', 'completedExerciseIds', 'quizScores', 'lastLessonId', 'progressPercent', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Bookmarks
    match /bookmarks/{bookmarkId} {
      allow get: if isValidId(bookmarkId) && isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(bookmarkId) && isSignedIn() &&
        isValidBookmark(incoming(), bookmarkId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(bookmarkId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Notes
    match /notes/{noteId} {
      allow get: if isValidId(noteId) && isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(noteId) && isSignedIn() &&
        isValidNote(incoming(), noteId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(noteId) && isSignedIn() &&
        isValidNote(incoming(), noteId) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'updatedAt']);
      allow delete: if isValidId(noteId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Projects (Private-by-default with Collaborator RBAC)
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (
        (isSignedIn() && resource == null) ||
        existing().visibility == 'public' ||
        isProjectMember(existing()) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        ('collaboratorIds' in resource.data && request.auth.uid in resource.data.collaboratorIds) ||
        resource.data.visibility == 'public' ||
        isAdmin()
      );
      allow create: if isValidId(projectId) && isSignedIn() &&
        isValidProject(incoming(), projectId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(projectId) && isSignedIn() &&
        isValidProject(incoming(), projectId) && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'visibility', 'isPortfolio',
              'milestonesCompleted', 'status', 'version', 'storageBytes',
              'architectureId', 'collaboratorIds', 'collaboratorRoles',
              'collaboratorNames', 'lastEditedByUid', 'lastEditedByName', 'updatedAt'
            ])
          ) ||
          (
            isProjectEditor(existing()) &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'version', 'storageBytes', 'lastEditedByUid', 'lastEditedByName', 'updatedAt'
            ])
          ) ||
          (
            hasAuthEmail() &&
            (!('collaboratorIds' in existing()) || !(request.auth.uid in existing().collaboratorIds)) &&
            exists(/databases/$(database)/documents/projectInvitations/$(projectId + '_' + authEmailSlug())) &&
            get(/databases/$(database)/documents/projectInvitations/$(projectId + '_' + authEmailSlug())).data.status == 'pending' &&
            get(/databases/$(database)/documents/projectInvitations/$(projectId + '_' + authEmailSlug())).data.inviteeEmail == authEmailLower() &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            ('collaboratorIds' in incoming()) &&
            request.auth.uid in incoming().collaboratorIds &&
            ('collaboratorRoles' in incoming()) &&
            incoming().collaboratorRoles[request.auth.uid] == get(/databases/$(database)/documents/projectInvitations/$(projectId + '_' + authEmailSlug())).data.role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'collaboratorIds', 'collaboratorRoles', 'collaboratorNames', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(projectId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());

      // Master Gate on Project Files (no get() in list queries)
      match /files/{fileId} {
        allow get: if isValidId(projectId) && isValidId(fileId) && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.visibility == 'public' ||
          isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data) ||
          isAdmin()
        );
        allow list: if isValidId(projectId) && (
          resource.data.visibility == 'public' ||
          (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
          (isSignedIn() && 'collaboratorIds' in resource.data && request.auth.uid in resource.data.collaboratorIds) ||
          isAdmin()
        );
        allow create: if isValidId(projectId) && isValidId(fileId) && isSignedIn() &&
          isValidProjectFile(incoming(), projectId, fileId) &&
          incoming().updatedAt == request.time &&
          isProjectEditor(get(/databases/$(database)/documents/projects/$(projectId)).data) &&
          incoming().ownerId == get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId;
        allow update: if isValidId(projectId) && isValidId(fileId) && isSignedIn() &&
          isValidProjectFile(incoming(), projectId, fileId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().projectId == existing().projectId && (
            (
              get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['collaboratorIds'])
            ) ||
            (
              incoming().updatedAt == request.time &&
              isProjectEditor(get(/databases/$(database)/documents/projects/$(projectId)).data) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'folder', 'language', 'visibility', 'content',
                'collaboratorIds', 'lastEditedByUid', 'lastEditedByName', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(projectId) && isValidId(fileId) && isSignedIn() && (
          isProjectEditor(get(/databases/$(database)/documents/projects/$(projectId)).data) || isAdmin()
        );
      }

      // Master Gate on Project Versions (Snapshot payload strictly immutable)
      match /versions/{versionId} {
        allow get: if isValidId(projectId) && isValidId(versionId) && isSignedIn() && (
          isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data) || isAdmin()
        );
        allow list: if isValidId(projectId) && isSignedIn() && (
          resource.data.ownerId == request.auth.uid ||
          ('collaboratorIds' in resource.data && request.auth.uid in resource.data.collaboratorIds) ||
          isAdmin()
        );
        allow create: if isValidId(projectId) && isValidId(versionId) && isSignedIn() &&
          isValidProjectVersion(incoming(), projectId, versionId) &&
          incoming().createdAt == request.time &&
          isProjectEditor(get(/databases/$(database)/documents/projects/$(projectId)).data) &&
          incoming().ownerId == get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId;
        allow update: if isValidId(projectId) && isValidId(versionId) && isSignedIn() &&
          isValidProjectVersion(incoming(), projectId, versionId) && (
            isAdmin() ||
            (
              get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['collaboratorIds'])
            )
          );
        allow delete: if isValidId(projectId) && isValidId(versionId) && isSignedIn() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin()
        );
      }

      // Project Collaboration Comments (Viewer is strictly read-only)
      match /comments/{commentId} {
        allow get: if isValidId(projectId) && isValidId(commentId) && isSignedIn() && (
          isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data) || isAdmin()
        );
        allow list: if isValidId(projectId) && isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          ('collaboratorIds' in resource.data && request.auth.uid in resource.data.collaboratorIds) ||
          isAdmin()
        );
        allow create: if isValidId(projectId) && isValidId(commentId) && isSignedIn() &&
          isValidProjectComment(incoming(), projectId, commentId) &&
          incoming().authorId == request.auth.uid &&
          incoming().status == 'open' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isProjectEditor(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow update: if isValidId(projectId) && isValidId(commentId) && isSignedIn() &&
          isValidProjectComment(incoming(), projectId, commentId) && (
            isAdmin() ||
            (
              isProjectEditor(get(/databases/$(database)/documents/projects/$(projectId)).data) &&
              incoming().authorId == existing().authorId &&
              incoming().projectId == existing().projectId &&
              incoming().createdAt == existing().createdAt &&
              incoming().updatedAt == request.time &&
              incoming().diff(existing()).affectedKeys().hasOnly(['body', 'status', 'resolvedBy', 'updatedAt'])
            ) ||
            (
              get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['collaboratorIds'])
            )
          );
        allow delete: if isValidId(projectId) && isValidId(commentId) && isSignedIn() && (
          existing().authorId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }

      // Project Collaboration Activity Timeline (Immutable log)
      match /activity/{activityId} {
        allow get: if isValidId(projectId) && isValidId(activityId) && isSignedIn() && (
          isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data) || isAdmin()
        );
        allow list: if isValidId(projectId) && isSignedIn() && (
          resource.data.actorId == request.auth.uid ||
          ('collaboratorIds' in resource.data && request.auth.uid in resource.data.collaboratorIds) ||
          isAdmin()
        );
        allow create: if isValidId(projectId) && isValidId(activityId) && isSignedIn() &&
          isValidProjectActivityEvent(incoming(), projectId, activityId) &&
          incoming().actorId == request.auth.uid &&
          incoming().createdAt == request.time &&
          isProjectMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow update: if false;
        allow delete: if isValidId(projectId) && isValidId(activityId) && isSignedIn() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid || isAdmin()
        );
      }
    }

    // Playgrounds (Private-by-default)
    match /playgrounds/{playgroundId} {
      allow get: if isValidId(playgroundId) && (
        (isSignedIn() && resource == null) ||
        existing().visibility == 'public' ||
        (isSignedIn() && existing().ownerId == request.auth.uid) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.visibility == 'public' ||
        isAdmin()
      );
      allow create: if isValidId(playgroundId) && isSignedIn() &&
        isValidPlayground(incoming(), playgroundId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(playgroundId) && isSignedIn() &&
        isValidPlayground(incoming(), playgroundId) && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().ownerId == existing().ownerId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'html', 'css', 'js', 'visibility', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(playgroundId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Challenge Attempts
    match /challengeAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(attemptId) && isSignedIn() &&
        isValidChallengeAttempt(incoming(), attemptId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Idempotent XP Transactions
    match /xpTransactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(txId) && isSignedIn() &&
        isValidXpTransaction(incoming(), txId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Achievements
    match /achievements/{achievementId} {
      allow get: if isValidId(achievementId) && isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(achievementId) && isSignedIn() &&
        isValidAchievement(incoming(), achievementId) &&
        incoming().userId == request.auth.uid &&
        incoming().unlockedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Community Posts
    match /communityPosts/{postId} {
      allow get: if isValidId(postId) && isSignedIn() && (
        resource == null ||
        existing().visibility == 'public' ||
        existing().authorId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(postId) && isVerifiedCommunityActor() &&
        isValidCommunityPost(incoming(), postId) &&
        incoming().authorId == request.auth.uid &&
        ((incoming().category != 'announcement' && (!('authorRole' in incoming()) || incoming().authorRole == 'member')) || isAdmin()) &&
        incoming().likesCount == 0 &&
        incoming().commentsCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(postId) && isSignedIn() &&
        isValidCommunityPost(incoming(), postId) && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            incoming().authorId == existing().authorId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'tags', 'codeSnippet', 'visibility', 'updatedAt'])
          ) ||
          (
            isVerifiedCommunityActor() &&
            incoming().authorId == existing().authorId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().likesCount >= 0 &&
            incoming().likesCount <= existing().likesCount + 1 &&
            incoming().commentsCount >= existing().commentsCount &&
            incoming().commentsCount <= existing().commentsCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'updatedAt'])
          )
        );
      allow delete: if isValidId(postId) && isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());

      // Community Post Comments
      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId) && isSignedIn() && (
          get(/databases/$(database)/documents/communityPosts/$(postId)).data.visibility == 'public' ||
          get(/databases/$(database)/documents/communityPosts/$(postId)).data.authorId == request.auth.uid ||
          isAdmin()
        );
        allow list: if isValidId(postId) && isSignedIn() && resource.data.postId == postId;
        allow create: if isValidId(postId) && isValidId(commentId) && isVerifiedCommunityActor() &&
          isValidComment(incoming(), postId, commentId) &&
          incoming().authorId == request.auth.uid &&
          ((!('authorRole' in incoming()) || incoming().authorRole == 'member') || isAdmin()) &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/communityPosts/$(postId));
        allow update: if false;
        allow delete: if isValidId(postId) && isValidId(commentId) && isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());
      }
    }

    // Moderation Reports
    match /reports/{reportId} {
      allow get: if isValidId(reportId) && isSignedIn() && (resource == null || existing().reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow create: if isValidId(reportId) && isVerifiedCommunityActor() &&
        isValidReport(incoming(), reportId) &&
        incoming().reporterId == request.auth.uid &&
        incoming().status == 'open' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(reportId) && isAdmin() &&
        isValidReport(incoming(), reportId) &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(notificationId) && isSignedIn() &&
        isValidNotification(incoming(), notificationId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isValidId(notificationId) && isSignedIn() &&
        isValidNotification(incoming(), notificationId) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Career Progress
    match /userCareerProgress/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidCareerProgress(incoming(), userId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidCareerProgress(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'selectedPathId', 'completedSkillIds', 'completedProjectIds', 'updatedAt'
        ]);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // AI Conversations
    match /aiConversations/{conversationId} {
      allow get: if isValidId(conversationId) && isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(conversationId) && isSignedIn() &&
        isValidAiConversation(incoming(), conversationId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(conversationId) && isSignedIn() &&
        isValidAiConversation(incoming(), conversationId) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'mode', 'messages', 'updatedAt']);
      allow delete: if isValidId(conversationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() &&
        isValidAdminAuditLog(incoming(), logId) &&
        incoming().adminId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Mission Mode Collections
    // -------------------------------------------------------------------------

    // Missions catalog (published readable by signed-in learners, Quality Gate enforced)
    match /missions/{missionId} {
      allow get: if isValidId(missionId) && isSignedIn() && (
        resource == null ||
        existing().status == 'published' ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.status == 'published' ||
        isAdmin()
      );
      allow create: if isValidId(missionId) && isAdmin() &&
        isValidMission(incoming(), missionId) &&
        (incoming().status != 'published' || ('qualityStatus' in incoming() && incoming().qualityStatus == 'approved')) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(missionId) && isAdmin() &&
        isValidMission(incoming(), missionId) &&
        (incoming().status != 'published' || ('qualityStatus' in incoming() && incoming().qualityStatus == 'approved')) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(missionId) && isAdmin();
    }

    // Mission Checkpoints
    match /missionCheckpoints/{checkpointId} {
      allow get: if isValidId(checkpointId) && isSignedIn() && (
        resource == null ||
        existing().status == 'active' ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.status == 'active' ||
        isAdmin()
      );
      allow create: if isValidId(checkpointId) && isAdmin() &&
        isValidMissionCheckpoint(incoming(), checkpointId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(checkpointId) && isAdmin() &&
        isValidMissionCheckpoint(incoming(), checkpointId) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(checkpointId) && isAdmin();
    }

    // Mission Starter Templates
    match /missionTemplates/{templateId} {
      allow get: if isValidId(templateId) && isSignedIn() && (
        resource == null ||
        existing().status == 'active' ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.status == 'active' ||
        isAdmin()
      );
      allow create: if isValidId(templateId) && isAdmin() &&
        isValidMissionTemplate(incoming(), templateId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(templateId) && isAdmin() &&
        isValidMissionTemplate(incoming(), templateId) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(templateId) && isAdmin();
    }

    // Mission Rewards Schedule
    match /missionRewards/{rewardId} {
      allow get: if isValidId(rewardId) && isSignedIn() && (
        resource == null ||
        existing().status == 'active' ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.status == 'active' ||
        isAdmin()
      );
      allow create: if isValidId(rewardId) && isAdmin() &&
        isValidMissionReward(incoming(), rewardId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(rewardId) && isAdmin() &&
        isValidMissionReward(incoming(), rewardId) &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(rewardId) && isAdmin();
    }

    // User Mission Attempts (Private per user, terminal completion locking)
    match /missionAttempts/{attemptId} {
      allow get: if isValidId(attemptId) && isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(attemptId) && isSignedIn() &&
        isValidMissionAttempt(incoming(), attemptId) &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'in_progress' &&
        incoming().rewardsGranted == false &&
        incoming().xpAwarded == 0 &&
        incoming().addedToPassport == false &&
        incoming().startedAt == request.time &&
        incoming().lastActivityAt == request.time;
      allow update: if isValidId(attemptId) && isSignedIn() &&
        isValidMissionAttempt(incoming(), attemptId) && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().missionId == existing().missionId &&
            incoming().startedAt == existing().startedAt &&
            incoming().lastActivityAt == request.time &&
            (
              // Action 1: Workspace edits & checkpoint progression (only while not yet completed)
              (
                existing().status != 'completed' &&
                incoming().status in ['in_progress', 'submitted', 'needs_improvement', 'archived'] &&
                incoming().rewardsGranted == false &&
                incoming().xpAwarded == 0 &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'currentCheckpointId', 'completedCheckpointIds',
                  'acknowledgedStepIds', 'files', 'version', 'checkpointFeedback',
                  'lastActivityAt'
                ])
              ) ||
              // Action 2: Verified completion transition
              (
                existing().status != 'completed' &&
                incoming().status == 'completed' &&
                incoming().completedAt == request.time &&
                incoming().xpAwarded >= 0 &&
                incoming().xpAwarded <= 250 &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'status', 'currentCheckpointId', 'completedCheckpointIds',
                  'acknowledgedStepIds', 'files', 'version', 'checkpointFeedback',
                  'rewardsGranted', 'xpAwarded', 'unlockedBadgeIds',
                  'lastActivityAt', 'completedAt'
                ])
              ) ||
              // Action 3: Export completed project to Skill Passport / Portfolio (terminal state preserved)
              (
                existing().status == 'completed' &&
                incoming().status == 'completed' &&
                incoming().rewardsGranted == existing().rewardsGranted &&
                incoming().xpAwarded == existing().xpAwarded &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'addedToPassport', 'portfolioProjectId', 'lastActivityAt'
                ])
              )
            )
          )
        );
      allow delete: if isValidId(attemptId) && isAdmin();
    }

    // Mission Submissions (Strictly immutable historical snapshots)
    match /missionSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(submissionId) && isSignedIn() &&
        isValidMissionSubmission(incoming(), submissionId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(submissionId) && isAdmin();
    }

    // Mission Evaluations (Strictly immutable server evaluation reports)
    match /missionEvaluations/{evaluationId} {
      allow get: if isValidId(evaluationId) && isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(evaluationId) && isSignedIn() &&
        isValidMissionEvaluation(incoming(), evaluationId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(evaluationId) && isAdmin();
    }

    // Mission Attempt Workspace Version Snapshots
    match /missionAttempts/{attemptId}/versions/{versionId} {
      allow get: if isValidId(attemptId) && isValidId(versionId) && isSignedIn() && (
        get(/databases/$(database)/documents/missionAttempts/$(attemptId)).data.userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isValidId(attemptId) && isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(attemptId) && isValidId(versionId) && isSignedIn() &&
        isValidMissionAttemptVersion(incoming(), attemptId, versionId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        get(/databases/$(database)/documents/missionAttempts/$(attemptId)).data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Mission Hint History
    match /missionHintHistory/{hintRecordId} {
      allow get: if isValidId(hintRecordId) && isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(hintRecordId) && isSignedIn() &&
        isValidMissionHintHistory(incoming(), hintRecordId) &&
        incoming().userId == request.auth.uid &&
        incoming().openedAt == request.time;
      allow update: if false;
      allow delete: if isValidId(hintRecordId) && isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
    }

    // Platform Config (Adaptive Difficulty Rules - Admin Managed)
    match /platformConfig/{configId} {
      allow get: if isValidId(configId) && isSignedIn();
      allow create, update: if isValidId(configId) && isAdmin() &&
        isValidAdaptiveDifficultyConfig(incoming(), configId) &&
        incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Mission Readiness Assessment Results (Owner & Admin Only)
    match /missionReadinessResults/{resultId} {
      allow get: if isValidId(resultId) && isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isValidId(resultId) && isSignedIn() &&
        isValidMissionReadinessResult(incoming(), resultId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if isValidId(resultId) && isSignedIn() &&
        isValidMissionReadinessResult(incoming(), resultId) &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().missionId == existing().missionId &&
        incoming().createdAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'scorePct', 'passedCount', 'totalCount', 'ready',
          'weakSkills', 'recommendedLessons', 'answers', 'createdAt'
        ]);
      allow delete: if isValidId(resultId) && isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
    }

    // Mission Quality Ratings (Optional, 1 per user per mission via deterministic ID)
    match /missionRatings/{ratingId} {
      allow get: if isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        isValidMissionRating(incoming(), ratingId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        isValidMissionRating(incoming(), ratingId) && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().missionId == existing().missionId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'difficultyRating', 'clarityRating', 'usefulnessRating',
              'starterQualityRating', 'overallRating', 'comment', 'updatedAt'
            ])
          )
        );
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Custom User-Authored Missions (Practice-Only, Zero Official Rewards)
    match /customMissions/{missionId} {
      allow get: if isValidId(missionId) && isSignedIn() && (
        resource == null ||
        existing().authorId == request.auth.uid ||
        (existing().visibility == 'shared' && existing().status == 'active') ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        (resource.data.visibility == 'shared' && resource.data.status == 'active') ||
        isAdmin()
      );
      allow create: if isValidId(missionId) && isSignedIn() &&
        isValidCustomMission(incoming(), missionId) &&
        incoming().authorId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(missionId) && isSignedIn() &&
        isValidCustomMission(incoming(), missionId) && (
          isAdmin() ||
          (
            existing().authorId == request.auth.uid &&
            incoming().authorId == existing().authorId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'description', 'scenario', 'category', 'language', 'difficulty',
              'skills', 'learningObjectives', 'requirements', 'checkpoints', 'starterFiles',
              'hints', 'completionCriteria', 'personalDeadline', 'visibility', 'status', 'updatedAt'
            ])
          ) ||
          (
            existing().visibility == 'shared' &&
            incoming().authorId == existing().authorId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['reportedCount', 'updatedAt'])
          )
        );
      allow delete: if isValidId(missionId) && isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());
    }

    // Mission Collaboration Teams (Role-Based Editor/Viewer Permissions)
    match /missionTeams/{teamId} {
      allow get: if isValidId(teamId) && isSignedIn() && (
        resource == null ||
        request.auth.uid in existing().memberIds ||
        exists(/databases/$(database)/documents/missionTeamInvites/$(teamId + '_' + request.auth.uid)) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        isAdmin()
      );
      allow create: if isValidId(teamId) && isSignedIn() &&
        isValidMissionTeam(incoming(), teamId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().memberRoles[request.auth.uid] == 'owner' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(teamId) && isSignedIn() &&
        isValidMissionTeam(incoming(), teamId) && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().ownerId == existing().ownerId &&
            incoming().missionId == existing().missionId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'memberIds', 'memberRoles', 'memberNames', 'checkpointAssignments',
              'files', 'version', 'completedCheckpointIds', 'contributions',
              'status', 'lastEditedByUid', 'lastEditedByName', 'updatedAt'
            ])
          ) ||
          (
            request.auth.uid in existing().memberIds &&
            existing().memberRoles[request.auth.uid] == 'editor' &&
            existing().status != 'completed' &&
            incoming().ownerId == existing().ownerId &&
            incoming().missionId == existing().missionId &&
            incoming().memberIds == existing().memberIds &&
            incoming().memberRoles == existing().memberRoles &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'files', 'version', 'completedCheckpointIds', 'contributions',
              'status', 'lastEditedByUid', 'lastEditedByName', 'updatedAt'
            ])
          ) ||
          (
            !(request.auth.uid in existing().memberIds) &&
            exists(/databases/$(database)/documents/missionTeamInvites/$(teamId + '_' + request.auth.uid)) &&
            request.auth.uid in incoming().memberIds &&
            incoming().ownerId == existing().ownerId &&
            incoming().missionId == existing().missionId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().memberRoles[request.auth.uid] == get(/databases/$(database)/documents/missionTeamInvites/$(teamId + '_' + request.auth.uid)).data.role &&
            incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'memberRoles', 'memberNames', 'updatedAt'])
          )
        );
      allow delete: if isValidId(teamId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Mission Team Invites (Deterministic ID: teamId_inviteeUid)
    match /missionTeamInvites/{inviteId} {
      allow get: if isSignedIn() && (
        resource == null ||
        existing().inviterId == request.auth.uid ||
        existing().inviteeUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.inviteeUid == request.auth.uid ||
        resource.data.inviterId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        isValidMissionTeamInvite(incoming(), inviteId) &&
        incoming().inviterId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        get(/databases/$(database)/documents/missionTeams/$(incoming().teamId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        isValidMissionTeamInvite(incoming(), inviteId) && (
          isAdmin() ||
          (
            existing().inviteeUid == request.auth.uid &&
            incoming().teamId == existing().teamId &&
            incoming().inviterId == existing().inviterId &&
            incoming().inviteeUid == existing().inviteeUid &&
            incoming().role == existing().role &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().status in ['accepted', 'declined'] &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'inviteeName', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && (
        existing().inviterId == request.auth.uid ||
        existing().inviteeUid == request.auth.uid ||
        isAdmin()
      );
    }

    // Real-time Mission Mode Leaderboard (non-PII public performance metrics)
    match /missionLeaderboard/{entryId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(entryId) && isSignedIn() &&
        isValidMissionLeaderboardEntry(incoming(), entryId) &&
        incoming().userId == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(entryId) && isSignedIn() &&
        isValidMissionLeaderboardEntry(incoming(), entryId) && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().missionId == existing().missionId &&
            incoming().updatedAt == request.time
          )
        );
      allow delete: if isValidId(entryId) && (isAdmin() || (isSignedIn() && existing().userId == request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // Five Major Development Systems Collections
    // -------------------------------------------------------------------------

    // Shared Project Collaboration Invitations (Email-targeted with deterministic ID)
    match /projectInvitations/{inviteId} {
      allow get: if isValidId(inviteId) && isSignedIn() && (
        resource == null ||
        existing().inviterId == request.auth.uid ||
        (hasAuthEmail() && existing().inviteeEmail == authEmailLower()) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.inviterId == request.auth.uid ||
        (hasAuthEmail() && resource.data.inviteeEmail == authEmailLower()) ||
        isAdmin()
      );
      allow create: if isValidId(inviteId) && isSignedIn() &&
        isValidProjectInvitation(incoming(), inviteId) &&
        incoming().inviterId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid;
      allow update: if isValidId(inviteId) && isSignedIn() &&
        isValidProjectInvitation(incoming(), inviteId) && (
          isAdmin() ||
          (
            hasAuthEmail() &&
            existing().inviteeEmail == authEmailLower() &&
            existing().status == 'pending' &&
            incoming().status in ['accepted', 'declined'] &&
            incoming().projectId == existing().projectId &&
            incoming().inviterId == existing().inviterId &&
            incoming().inviteeEmail == existing().inviteeEmail &&
            incoming().role == existing().role &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            existing().inviterId == request.auth.uid &&
            incoming().projectId == existing().projectId &&
            incoming().inviterId == existing().inviterId &&
            incoming().inviteeEmail == existing().inviteeEmail &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().status in ['pending', 'cancelled'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'role', 'inviteSignature', 'expiresAt', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(inviteId) && isSignedIn() && (
        existing().inviterId == request.auth.uid ||
        (hasAuthEmail() && existing().inviteeEmail == authEmailLower()) ||
        isAdmin()
      );
    }

    // TestLab Test Suites
    match /testSuites/{suiteId} {
      allow get: if isValidId(suiteId) && isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        ('collaboratorIds' in existing() && request.auth.uid in existing().collaboratorIds) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ('collaboratorIds' in resource.data && request.auth.uid in resource.data.collaboratorIds) ||
        isAdmin()
      );
      allow create: if isValidId(suiteId) && isSignedIn() &&
        isValidTestSuite(incoming(), suiteId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isProjectEditor(get(/databases/$(database)/documents/projects/$(incoming().projectId)).data);
      allow update: if isValidId(suiteId) && isSignedIn() &&
        isValidTestSuite(incoming(), suiteId) && (
          isAdmin() ||
          (
            incoming().userId == existing().userId &&
            incoming().projectId == existing().projectId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            isProjectEditor(get(/databases/$(database)/documents/projects/$(existing().projectId)).data) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'cases', 'approved', 'collaboratorIds', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(suiteId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // TestLab Execution Runs (Immutable historical results & coverage)
    match /testRuns/{runId} {
      allow get: if isValidId(runId) && isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        ('collaboratorIds' in existing() && request.auth.uid in existing().collaboratorIds) ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        ('collaboratorIds' in resource.data && request.auth.uid in resource.data.collaboratorIds) ||
        isAdmin()
      );
      allow create: if isValidId(runId) && isSignedIn() &&
        isValidTestRunSession(incoming(), runId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        isProjectMember(get(/databases/$(database)/documents/projects/$(incoming().projectId)).data);
      allow update: if false;
      allow delete: if isValidId(runId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Architect Plans & Sub-Versions
    match /architectures/{archId} {
      allow get: if isValidId(archId) && isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(archId) && isSignedIn() &&
        isValidArchitecturePlan(incoming(), archId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(archId) && isSignedIn() &&
        isValidArchitecturePlan(incoming(), archId) && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid &&
            incoming().userId == existing().userId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'projectId', 'title', 'prompt', 'overview', 'frontendSpec',
              'backendSpec', 'authSpec', 'techStack', 'modules',
              'databaseTables', 'apiEndpoints', 'diagrams', 'versionNumber',
              'status', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(archId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());

      match /versions/{versionId} {
        allow get: if isValidId(archId) && isValidId(versionId) && isSignedIn() && (
          get(/databases/$(database)/documents/architectures/$(archId)).data.userId == request.auth.uid || isAdmin()
        );
        allow list: if isValidId(archId) && isSignedIn() && (
          resource.data.userId == request.auth.uid || isAdmin()
        );
        allow create: if isValidId(archId) && isValidId(versionId) && isSignedIn() &&
          isValidArchitectureVersion(incoming(), archId, versionId) &&
          incoming().userId == request.auth.uid &&
          incoming().createdAt == request.time &&
          get(/databases/$(database)/documents/architectures/$(archId)).data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isValidId(archId) && isValidId(versionId) && isSignedIn() && (
          get(/databases/$(database)/documents/architectures/$(archId)).data.userId == request.auth.uid || isAdmin()
        );
      }
    }

    // Developer Insights Activity Feed (Strictly User-Scoped & Owner-Deletable)
    match /activityEvents/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && (
        resource == null ||
        existing().userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isValidId(eventId) && isSignedIn() &&
        isValidActivityEvent(incoming(), eventId) &&
        incoming().userId == request.auth.uid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(eventId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
